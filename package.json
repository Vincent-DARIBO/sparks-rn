{
  "name": "sparks-rn",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^7.0.9",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.108.4",
    "expo": "~58.0.26",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.32",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "json-server": "1.0.0-beta.15",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "api": "json-server api/db.json --host 0.0.0.0 --port 3000",
    "api:reset": "bun -e \"await Bun.write('api/db.json', Bun.file('api/db.seed.json'))\""
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
