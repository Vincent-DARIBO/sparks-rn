{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Alias d'import : `@/theme` au lieu de `../../../theme`.
    // Expo (Metro) lit ces chemins directement : aucune configuration Babel nécessaire.
    "paths": {
      "@/*": ["./src/*"]
    },
    // Depuis TypeScript 6, les types globaux (@types/*) ne sont plus inclus automatiquement.
    // `jest` déclare describe, it, expect, jest…
    "types": ["jest"]
  }
}
